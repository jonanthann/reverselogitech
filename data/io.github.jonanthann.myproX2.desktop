# Exec=myprox2 vale para o pacote .deb (/usr/bin/myprox2). Este arquivo é só o modelo: o instalar-local grava uma cópia com o Exec absoluto.
[Desktop Entry]
Type=Application
Name=myproX2
Comment=Bateria e configurações do mouse PRO X 2
Exec=myprox2 %U
Icon=io.github.jonanthann.myproX2
Terminal=false
Categories=Settings;HardwareSettings;
StartupNotify=true
X-GNOME-UsesNotifications=true
